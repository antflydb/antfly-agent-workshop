# Lives at the working-copy root, one level above the apps; each app reads
# ../.env.local. Real values stay out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# The engine the app searches. Locally: the output of `node promote.mjs local`
# (SearchAF's Antfly on this Mac, table `files`, no key). On Cloud: the
# instance's API base from the dashboard, the published table, and the
# instance key (swap in a read-only key before other people use the app).
ANTFLY_API_BASE=http://127.0.0.1:<port>
ANTFLY_TABLE=files
ANTFLY_API_KEY=
# Set the final Sites URL when deploying.
SITE_URL=

# Optional link from meeting-prep to your own knowledge-agent Site.
KNOWLEDGE_AGENT_URL=
# Optional link from project-handoff to your own meeting-prep Site.
MEETING_AGENT_URL=
