# Store real values only in an ignored, owner-readable .env.local.
OPENAI_API_KEY=
# Cloud is the default; choose local-tunnel explicitly for the optional local path.
ANTFLY_RETRIEVAL_MODE=cloud
ANTFLY_CLOUD_API_BASE=https://platform.antfly.io/cloud/v1/<instance_id>
ANTFLY_CLOUD_TABLE=
ANTFLY_CORPUS_VERSION=
# Table-scoped read-only key, server only.
ANTFLY_CLOUD_API_KEY=
# Used only with ANTFLY_RETRIEVAL_MODE=local-tunnel.
ANTFLY_TUNNEL_ID=
OPENAI_MODEL=gpt-6-astra
# Set the final trusted Sites URL when deploying.
SITE_URL=

# Optional link from meeting-prep to your own knowledge-agent Site.
KNOWLEDGE_AGENT_URL=

# Optional link from project-handoff to your own meeting-prep Site.
MEETING_AGENT_URL=
