# Store real values only in an ignored, owner-readable .env.local.
OPENAI_API_KEY=
ANTFLY_TUNNEL_ID=
OPENAI_MODEL=gpt-6-astra
# Set the final trusted Sites URL when deploying.
SITE_URL=

# Optional navigation: use only your own deployed HTTPS Sites.
# Unconfigured destinations are hidden. Links do not grant access or transfer conversations.
KNOWLEDGE_AGENT_URL=
MEETING_AGENT_URL=
HANDOFF_AGENT_URL=
SUPPORT_AGENT_URL=
