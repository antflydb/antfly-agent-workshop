# The agent copies this to ~/antfly-workshop/.env.local. You fill in the
# values there; they never go into chat or Git. Every app reads ../.env.local.

# Before "Build the agent": your OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Leave these to the agent while the app runs locally (it fills in SearchAF's
# engine on this Mac). Before "Deploy everything": set ANTFLY_API_BASE to your
# instance URL and ANTFLY_API_KEY to your instance key; the agent sets the table.
ANTFLY_API_BASE=
ANTFLY_TABLE=
ANTFLY_API_KEY=

# Set by the agent when deploying.
SITE_URL=
