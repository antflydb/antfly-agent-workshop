# Copy to .env.local in the app directory. Real values stay out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Your instance's API base, from the Antfly Cloud dashboard.
ANTFLY_CLOUD_API_BASE=https://platform.antfly.io/cloud/v1/<instance_id>
# The table the promote tool published to.
ANTFLY_CLOUD_TABLE=atlas_workshop
# The instance key, server only. Swap in a table-scoped read-only key before
# other people use the app.
ANTFLY_CLOUD_API_KEY=
# Set the final Sites URL when deploying.
SITE_URL=

# Optional link from meeting-prep to your own knowledge-agent Site.
KNOWLEDGE_AGENT_URL=
# Optional link from project-handoff to your own meeting-prep Site.
MEETING_AGENT_URL=
